# Export engine: pbexport (built here from app/) plus the official rclone
# binary. Every base image is pinned by tag and digest; the auto-release
# workflow bumps the rclone reference in build-images.sh.
#

ARG RCLONE_IMAGE=docker.io/rclone/rclone:1.75.2@sha256:2687085f718d3c628f7fdfb77c52a1d344332aed543110bb88088f2c70d43eb5

FROM ${RCLONE_IMAGE} AS rclone

FROM docker.io/library/golang:1.27.2-alpine3.24@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY *.go ./
RUN go vet ./... \
    && go test ./... \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/pbexport .

FROM docker.io/library/alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -H -u 65532 -s /sbin/nologin pbexport \
    && install -d -m 0700 -o pbexport -g pbexport /work /rclone
COPY --from=rclone /usr/local/bin/rclone /usr/local/bin/rclone
COPY --from=builder /out/pbexport /usr/local/bin/pbexport
ENV RCLONE_CONFIG=/rclone/rclone.conf \
    PBEXPORT_WORKDIR=/work \
    HOME=/work
USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/pbexport"]
