# Log in to Passbolt with the stored account, pin the server key on the first
# successful contact (or again when "repin" is set), count what the account
# can see and probe the upload target.

import json
import sys

import agent
import pbx

request = json.load(sys.stdin)
if request.get("repin"):
    pbx.set_secrets({"verify_token": "", "verify_enc_token": ""})
    print(agent.SD_WARNING + "server pin removed on request, pinning the current server key", file=sys.stderr)

if not agent.read_envfile("environment").get("PASSBOLT_URL") or not pbx.has_secret("private_key") \
        or not pbx.has_secret("passphrase"):
    agent.set_status("validation-failed")
    json.dump([{"field": "passbolt_url", "parameter": "passbolt_url", "value": "", "error": "account_incomplete"}],
              fp=sys.stdout)
    sys.exit(3)

try:
    with pbx.run_lock():
        result = pbx.run_engine("check", pbx.engine_payload(True))
        pinned = pbx.store_pin(result)
except RuntimeError as exc:
    result, pinned = {"ok": False, "error": str(exc)}, False

if result.get("user"):
    agent.set_env("PASSBOLT_USER", result["user"])

out = {
    "ok": bool(result.get("ok")),
    "error": result.get("error", ""),
    "user": result.get("user", ""),
    "resources": result.get("resources", 0),
    "folders": result.get("folders", 0),
    "target_checked": pbx.target_configured(),
    "target_ok": bool(result.get("target_ok")),
    "pinned_now": pinned,
}
if not out["ok"]:
    print(agent.SD_ERR + "check failed: %s" % out["error"], file=sys.stderr)
json.dump(out, fp=sys.stdout)
