# Create the empty secrets file (0600) and the rclone directory (0700): both
# are listed in etc/state-include.conf. This module generates no secret of
# its own; the administrator enters them in the settings page.

import os

import modsecrets
import pbx

modsecrets.ensure({})
os.makedirs(pbx.rclone_dir(), mode=0o700, exist_ok=True)
